# Master credentials file for the workspace.
#
# COPY THIS FILE to `credentials.env` in the same directory and fill in real values.
# `credentials.env` is gitignored and must NEVER be committed or shared.
#
# The Mind never sees this file. Only credential NAMES (not values) should appear
# inside the AI_Brain vault, referenced from project `requirements.md` files.
#
# Examples below — delete and replace with the credentials your projects actually need.

# --- LLM providers ---
# OPENROUTER_API_KEY=

# --- Data / web ---
# FIRECRAWL_API_KEY=
# SERP_API_KEY=

# --- Integrations ---
# GITHUB_TOKEN=
# NOTION_TOKEN=

# --- Storage / infra ---
# DATABASE_URL=
# REDIS_URL=
